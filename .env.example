# Copy to .env  (cp .env.example .env)

# Local MongoDB, the same server Compass connects to at mongodb://localhost:27017
MONGODB_URI=mongodb://127.0.0.1:27017/dorm-cricket

# Later, swap in your Atlas string instead (keep the database name before the "?"):
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/dorm-cricket?retryWrites=true&w=majority

PORT=5000

# Passwords. Anyone can look at the site; these two unlock the rest.
#   SCORER_PASSWORD: lets someone score matches
#   ADMIN_PASSWORD:  scoring too, plus deleting matches, Settings (players, images), backup and import
# If you leave these out the defaults are "admin" and "scorer", so set your own.
ADMIN_PASSWORD=change-me-admin
SCORER_PASSWORD=change-me-scorer
# Optional: a long random string used to sign login tokens (changing it signs everyone out)
# AUTH_SECRET=
